// The Faces tab: a wide left column for what is being timed, and a narrow right column for the categories to
// pick from.
//
// Everything shown comes from `FacesData`, which Rust fills from the database; every click is a callback on
// it. This file holds no state of its own beyond what is being typed into the name field.
//
// The left column is a square sized from the column width. Idle, it is empty. Timing by hand, it holds the
// play/pause glyph in the category's colour and today's total under it, with the category's name below the
// square. The glyph shows what is happening, not what clicking does: play while time is being recorded,
// pause while it is stopped. Following a cube that says which face is up, the square holds the cube lit in that
// face's category colour with the category's icon on its centre face, white and unlit for a face with no category,
// and today's total goes under the name beside a glyph saying whether the cube is running.

import { Palette, Button, LineEdit } from "std-widgets.slint";
import { Metrics } from "metrics.slint";
import { Swatch } from "widgets.slint";

// One category as the pick list draws it.
export struct FaceCategory {
    id: int,
    name: string,
    colour: color,
    has-colour: bool,
    icon: image,
    has-icon: bool,
    white-lines: bool,
}

// What the Faces tab shows and what it can be asked to do. Set from Rust; read by `FacesPane`.
export global FacesData {
    in property <[FaceCategory]> categories;

    // A category is on the current app face. False draws the idle column.
    in property <bool> has-category: false;
    in property <bool> running: false;
    in property <string> timing-category;
    in property <color> timing-colour;
    in property <bool> has-timing-colour: false;
    // Whether the cube's inner lines and centre icon are drawn white rather than black on the category's colour.
    in property <bool> timing-white-lines: false;
    in property <image> timing-icon;
    in property <bool> has-timing-icon: false;
    in property <string> elapsed: "0:00:00";
    // Whether pressing the glyph does anything: false when idle or when a resume is refused.
    in property <bool> glyph-enabled: false;
    // Whether a category click does anything.
    in property <bool> rows-enabled: true;

    // While a cube is followed: the face it is resting on (0 for none known) and whether that face keeps its
    // category. A category click then puts the category on that face.
    in property <bool> is-following-cube: false;
    in property <int> device-face: 0;
    in property <bool> is-face-locked: false;
    callback face-lock-pressed();

    // The Create control: the button, or the name field with Save.
    in-out property <bool> creating: false;
    in-out property <string> typed-name;

    callback category-picked(int);
    callback play-pause-pressed();
    callback create-opened();
    callback name-edited(string);
    callback create-saved(string);
    callback create-cancelled();
}

// Play while `running`, pause otherwise, `side` square in `colour`.
component PlayPauseShape inherits Rectangle {
    in property <bool> running;
    in property <color> colour;
    in property <length> side;

    width: root.side;
    height: root.side;

    if root.running: Path {
        width: root.side;
        height: root.side;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 20 8 L 88 50 L 20 92 Z";
        fill: root.colour;
    }

    if !root.running: HorizontalLayout {
        spacing: root.side * 0.22;
        padding-left: root.side * 0.16;
        padding-right: root.side * 0.16;
        Rectangle { background: root.colour; border-radius: root.side * 0.04; }
        Rectangle { background: root.colour; border-radius: root.side * 0.04; }
    }
}

// The manual clock's glyph, which pauses and resumes it.
component PlayPauseGlyph inherits Rectangle {
    in property <bool> running;
    in property <bool> enabled;
    in property <color> colour;
    in property <length> side;

    width: root.side;
    height: root.side;
    opacity: root.enabled ? 1 : 0.4;

    accessible-role: button;
    accessible-id: "timing-play-pause";
    accessible-label: root.running ? "Running, click to pause" : "Paused, click to resume";
    accessible-enabled: root.enabled;
    accessible-action-default => { root.pressed(); }

    callback pressed();

    PlayPauseShape { running: root.running; colour: root.colour; side: root.side; }

    TouchArea { clicked => { root.pressed(); } }
}

// The cube seen from above, `side` square: the body in `body`, the inner lines and the centre face's `icon` in `ink`,
// and the outline black. The paths are `ic_facet.svg`'s mark, in its own 65 unit box.
component CubePicture inherits Rectangle {
    in property <length> side;
    in property <color> body;
    in property <color> ink;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> label;

    width: root.side;
    height: root.side;

    accessible-role: image;
    accessible-id: "timing-cube";
    accessible-label: root.label;

    property <string> outline: "M 32.5 5.5 L 48.37 10.657 L 58.179 24.157 V 40.843 L 48.37 54.343 L 32.5 59.5 L 16.63 54.343 L 6.821 40.843 V 24.157 L 16.63 10.657 Z";

    Path {
        width: root.side;
        height: root.side;
        viewbox-width: 65;
        viewbox-height: 65;
        commands: root.outline;
        fill: root.body;
    }
    Path {
        width: root.side;
        height: root.side;
        viewbox-width: 65;
        viewbox-height: 65;
        commands: "M 48.37 27.343 L 42.308 46 H 22.692 L 16.63 27.343 L 32.5 15.813 Z M 32.5 15.813 V 5.5 M 48.37 27.343 L 58.179 24.157 M 42.308 46 L 48.37 54.343 M 22.692 46 L 16.63 54.343 M 16.63 27.343 L 6.821 24.157";
        stroke: root.ink;
        stroke-width: root.side * 1.5 / 65;
    }
    Path {
        width: root.side;
        height: root.side;
        viewbox-width: 65;
        viewbox-height: 65;
        commands: root.outline;
        stroke: black;
        stroke-width: root.side * 1.5 / 65;
    }
    // The largest square inside the centre pentagon is 0.29 of the mark's width, and the mark is 51.358 of the 65.
    if root.has-icon: Image {
        x: (root.side - self.width) / 2;
        y: root.side * 32.1 / 65 - self.height / 2;
        width: root.side * 0.29 * 51.358 / 65;
        height: self.width;
        source: root.icon;
        colorize: root.ink;
        accessible-role: image;
        accessible-id: "timing-centre-icon";
        accessible-label: FacesData.timing-category;
    }
}

// Whether the cube is running, beside today's figure under the name. A readout: pausing the cube is the menu bar's.
component CubeStateGlyph inherits Rectangle {
    in property <bool> running;
    in property <color> colour;
    in property <length> side;

    width: root.side;
    height: root.side;

    accessible-role: image;
    accessible-id: "timing-face-glyph";
    accessible-label: root.running ? "Cube running" : "Cube paused";

    PlayPauseShape { running: root.running; colour: root.colour; side: root.side; }
}

// One category as a row of the pick list. The whole row is the control.
component PickRow inherits Rectangle {
    in property <FaceCategory> category;
    in property <bool> enabled;

    height: 36px;
    opacity: root.enabled ? 1 : 0.5;

    accessible-role: button;
    accessible-id: "category-row-" + root.category.id;
    accessible-label: root.category.name;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.picked(); }

    callback picked();

    background: touch.has-hover && root.enabled ? Palette.alternate-background : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;

        Rectangle {
            width: 28px;
            Swatch {
                colour: root.category.colour;
                has-colour: root.category.has-colour;
                icon: root.category.icon;
                has-icon: root.category.has-icon;
                white-lines: root.category.white-lines;
                size: 28px;
                radius: 6px;
            }
        }

        Text {
            text: root.category.name;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground;
        }
    }

    touch := TouchArea { clicked => { root.picked(); } }
}

// The Create button, which becomes a name field and Save. Return saves and Escape cancels.
component CreateControl inherits Rectangle {
    height: 28px;

    if !FacesData.creating: HorizontalLayout {
        alignment: start;
        Button {
            text: "Create";
            accessible-id: "create-category";
            clicked => { FacesData.create-opened(); }
        }
    }

    if FacesData.creating: FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                FacesData.create-cancelled();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            spacing: 8px;
            field := LineEdit {
                placeholder-text: "Category name";
                text <=> FacesData.typed-name;
                accessible-id: "category-name-field";
                accessible-label: "Category name";
                edited(text) => { FacesData.name-edited(text); }
                accepted(text) => { FacesData.create-saved(text); }
                init => { self.focus(); }
            }
            Button {
                text: "Save";
                accessible-id: "save-category";
                clicked => { FacesData.create-saved(FacesData.typed-name); }
            }
        }
    }
}

export component FacesPane inherits Rectangle {
    accessible-role: tab-panel;
    accessible-id: "settings-pane-faces";
    accessible-label: "Faces";

    // The left column is twice the width of the right.
    property <length> gutter: 24px;
    property <length> content-width: root.width - 2 * Metrics.tab-padding;
    property <length> right-width: (root.content-width - root.gutter) / 3;
    property <length> left-width: root.right-width * 2;
    property <color> glyph-colour: FacesData.has-timing-colour ? FacesData.timing-colour : Palette.foreground;
    property <bool> shows-cube: FacesData.is-following-cube && FacesData.device-face > 0;

    HorizontalLayout {
        padding: Metrics.tab-padding;
        spacing: root.gutter;
        alignment: start;

        // The Timing column.
        VerticalLayout {
            width: root.left-width;
            spacing: Metrics.heading-spacing;
            alignment: start;

            Text {
                text: "Timing";
                font-size: Metrics.heading-font-size;
                font-weight: 700;
                color: Palette.foreground;
                accessible-role: AccessibleRole.text;
                accessible-id: "faces-timing-heading";
                accessible-label: "Timing";
            }

            // The square, and everything in it sized from its side.
            Rectangle {
                height: root.left-width;

                if root.shows-cube: CubePicture {
                    side: root.left-width;
                    body: FacesData.has-timing-colour ? FacesData.timing-colour : white;
                    ink: FacesData.timing-white-lines ? white : black;
                    icon: FacesData.timing-icon;
                    has-icon: FacesData.has-category && FacesData.has-timing-icon;
                    label: FacesData.has-category
                        ? "The cube, face " + FacesData.device-face + ", lit for " + FacesData.timing-category
                        : "The cube, face " + FacesData.device-face + ", unlit";
                }

                if !root.shows-cube && FacesData.has-category: VerticalLayout {
                    alignment: center;
                    spacing: root.left-width * 0.29 * 0.12;

                    HorizontalLayout {
                        alignment: center;
                        PlayPauseGlyph {
                            running: FacesData.running;
                            enabled: FacesData.glyph-enabled;
                            colour: root.glyph-colour;
                            side: root.left-width * 0.29;
                            pressed => { if FacesData.glyph-enabled { FacesData.play-pause-pressed(); } }
                        }
                    }

                    Text {
                        text: FacesData.elapsed;
                        horizontal-alignment: center;
                        font-size: root.left-width * 0.29 * 0.3;
                        font-weight: 500;
                        color: Palette.foreground;
                        opacity: 0.6;
                        accessible-role: AccessibleRole.text;
                        accessible-id: "timing-elapsed";
                        accessible-label: FacesData.elapsed;
                    }
                }
            }

            // Which face of the cube is up, and its lock. Shown only while a cube is followed and says which face.
            if FacesData.is-following-cube && FacesData.device-face > 0: HorizontalLayout {
                alignment: center;
                spacing: 12px;
                Text {
                    text: "Face " + FacesData.device-face;
                    vertical-alignment: center;
                    color: Palette.foreground;
                    accessible-role: AccessibleRole.text;
                    accessible-id: "timing-device-face";
                    accessible-label: "Face " + FacesData.device-face;
                }
                Button {
                    text: FacesData.is-face-locked ? "Unlock face" : "Lock face";
                    accessible-id: "timing-face-lock";
                    clicked => { FacesData.face-lock-pressed(); }
                }
            }

            if FacesData.has-category: Text {
                text: FacesData.timing-category;
                horizontal-alignment: center;
                font-size: 40px;
                font-weight: 600;
                wrap: word-wrap;
                overflow: elide;
                max-height: 2 * 48px;
                color: Palette.foreground;
                accessible-role: AccessibleRole.text;
                accessible-id: "timing-category-name";
                accessible-label: FacesData.timing-category;
            }

            // Today's total, under the name while the square is the cube.
            if root.shows-cube && FacesData.has-category: HorizontalLayout {
                alignment: center;
                spacing: 8px;
                CubeStateGlyph {
                    running: FacesData.running;
                    colour: root.glyph-colour;
                    side: 16px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: FacesData.elapsed;
                    vertical-alignment: center;
                    font-size: 16px;
                    font-weight: 500;
                    color: Palette.foreground;
                    opacity: 0.6;
                    accessible-role: AccessibleRole.text;
                    accessible-id: "timing-face-elapsed";
                    accessible-label: FacesData.elapsed;
                }
            }
        }

        // The Categories column.
        VerticalLayout {
            width: root.right-width;
            spacing: Metrics.heading-spacing;
            alignment: start;

            Text {
                text: "Categories";
                font-size: Metrics.heading-font-size;
                font-weight: 700;
                color: Palette.foreground;
                accessible-role: AccessibleRole.text;
                accessible-id: "faces-categories-heading";
                accessible-label: "Categories";
            }

            if FacesData.categories.length > 0: Rectangle {
                background: Palette.control-background;
                border-radius: Metrics.corner-radius;
                border-width: 1px;
                border-color: Palette.border;
                clip: true;

                accessible-role: list;
                accessible-id: "category-list";
                accessible-label: "Categories";

                VerticalLayout {
                    alignment: start;

                    for category[index] in FacesData.categories: VerticalLayout {
                        // Between rows and never above the first.
                        if index > 0: Rectangle { height: 1px; background: Palette.border; }
                        PickRow {
                            category: category;
                            enabled: FacesData.rows-enabled;
                            picked => { if FacesData.rows-enabled { FacesData.category-picked(category.id); } }
                        }
                    }
                }
            }

            CreateControl { }
        }
    }
}
