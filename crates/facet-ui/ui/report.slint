// The Report tab: a date range across the top, and what each category recorded over it underneath.
//
// A range covers app days, not calendar days: 5 August to 7 August runs from the daily reset on 5 August to
// the daily reset on 8 August. The To calendar starts unset, which reports the From day alone; the To
// calendar refuses days before From, and both refuse days after today. The totals list only categories that
// recorded something; each folds open onto the entries behind its figure.
//
// Everything shown comes from `ReportData`, which Rust fills; every click is a callback on it. The calendar
// cells are sized from the width the tab is given, and every other calendar size is a ratio of the cell.

import { Palette, ScrollView } from "std-widgets.slint";
import { Metrics } from "metrics.slint";
import { Divider, Swatch } from "widgets.slint";

// One cell of a calendar.
export struct ReportDay {
    iso: string,
    number: int,
    label: string,
    is-in-month: bool,
    is-allowed: bool,
    is-selected: bool,
    is-in-range: bool,
    is-range-start: bool,
    is-range-end: bool,
}

// One entry behind a total.
export struct ReportEntry {
    id: int,
    date: string,
    began: string,
    ended: string,
    duration: string,
    label: string,
}

// What one category came to over the range.
export struct ReportTotal {
    id: int,
    name: string,
    colour: color,
    has-colour: bool,
    icon: image,
    has-icon: bool,
    white-lines: bool,
    duration: string,
    is-expanded: bool,
    entries: [ReportEntry],
}

export global ReportData {
    in property <string> from-month;
    in property <string> to-month;
    in property <[ReportDay]> from-days;
    in property <[ReportDay]> to-days;
    in property <bool> from-previous-enabled;
    in property <bool> from-next-enabled;
    in property <bool> to-previous-enabled;
    in property <bool> to-next-enabled;
    // Beside the To title while no end is set.
    in property <string> to-subtitle;

    in property <[ReportTotal]> totals;
    in property <string> category-heading: "Category";
    in property <string> time-heading: "Time";

    callback day-picked(string, string);
    callback month-stepped(string, int);
    callback sort-pressed(string);
    callback total-toggled(int);
}

component DayCell inherits Rectangle {
    in property <ReportDay> day;
    in property <string> calendar-name;
    in property <length> cell-size;
    in property <length> font-size;
    in property <length> corner;

    width: root.cell-size;
    height: root.cell-size;

    accessible-role: button;
    accessible-id: "report-" + root.calendar-name + "-" + root.day.iso;
    accessible-label: root.day.label;
    accessible-enabled: root.day.is-allowed;
    accessible-action-default => { root.pick(); }

    function pick() {
        if root.day.is-allowed {
            ReportData.day-picked(root.calendar-name, root.day.iso);
        }
    }

    // The range: a tint across every day in it, rounded only at its two ends.
    if root.day.is-in-range && !root.day.is-selected: Rectangle {
        background: Palette.accent-background.with-alpha(0.15);
        border-top-left-radius: root.day.is-range-start ? root.corner : 0px;
        border-bottom-left-radius: root.day.is-range-start ? root.corner : 0px;
        border-top-right-radius: root.day.is-range-end ? root.corner : 0px;
        border-bottom-right-radius: root.day.is-range-end ? root.corner : 0px;
    }
    if root.day.is-selected: Rectangle {
        background: Palette.accent-background;
        border-radius: root.corner;
    }

    Text {
        text: root.day.number;
        font-size: root.font-size;
        font-weight: root.day.is-in-range ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.day.is-selected ? Palette.accent-foreground : Palette.foreground;
        opacity: !root.day.is-allowed ? 0.3 : root.day.is-in-month ? 1.0 : 0.55;
    }

    TouchArea { clicked => { root.pick(); } }
}

component MonthArrow inherits Rectangle {
    in property <string> glyph;
    in property <string> arrow-id;
    in property <string> label;
    in property <bool> enabled;
    in property <length> font-size;
    callback stepped();

    accessible-role: button;
    accessible-id: root.arrow-id;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.stepped(); } }

    Text {
        text: root.glyph;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Palette.foreground;
        opacity: root.enabled ? 0.75 : 0.25;
    }
    TouchArea { clicked => { if root.enabled { root.stepped(); } } }
}

component RangeCalendar inherits VerticalLayout {
    in property <string> title;
    in property <string> name;
    in property <string> subtitle;
    in property <string> month-title;
    in property <[ReportDay]> days;
    in property <bool> previous-enabled;
    in property <bool> next-enabled;
    in property <length> cell-size;

    property <length> day-font: Math.round(root.cell-size / 1px * 12 / 28) * 1px;
    property <length> weekday-font: Math.round(root.cell-size / 1px * 11 / 28) * 1px;
    property <length> month-font: Math.round(root.cell-size / 1px * 13 / 28) * 1px;
    property <length> arrow-size: Math.round(root.cell-size / 1px * 20 / 28) * 1px;
    property <length> day-corner: Math.round(root.cell-size / 1px * 5 / 28) * 1px;

    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;
        alignment: start;

        Text {
            text: root.title;
            font-size: Metrics.heading-font-size;
            font-weight: 700;
            color: Palette.foreground;
            accessible-role: AccessibleRole.text;
            accessible-id: "report-" + root.name + "-title";
            accessible-label: root.title;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            vertical-alignment: bottom;
            font-size: Metrics.footnote-font-size;
            color: Palette.foreground;
            opacity: 0.55;
            accessible-role: AccessibleRole.text;
            accessible-id: "report-" + root.name + "-subtitle";
            accessible-label: root.subtitle;
        }
    }

    Rectangle {
        background: Palette.control-background;
        border-radius: Metrics.corner-radius;
        border-width: 1px;
        border-color: Palette.border;
        clip: true;

        accessible-role: groupbox;
        accessible-id: "report-calendar-" + root.name;
        accessible-label: root.title;

        VerticalLayout {
            padding: 8px;
            spacing: 4px;

            HorizontalLayout {
                height: root.arrow-size;
                MonthArrow {
                    width: root.arrow-size;
                    glyph: "\u{2039}";
                    arrow-id: "report-" + root.name + "-previous-month";
                    label: "Previous month";
                    enabled: root.previous-enabled;
                    font-size: root.month-font;
                    stepped => { ReportData.month-stepped(root.name, -1); }
                }
                Text {
                    text: root.month-title;
                    font-size: root.month-font;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Palette.foreground;
                    accessible-role: AccessibleRole.text;
                    accessible-id: "report-" + root.name + "-month";
                    accessible-label: root.month-title;
                }
                MonthArrow {
                    width: root.arrow-size;
                    glyph: "\u{203a}";
                    arrow-id: "report-" + root.name + "-next-month";
                    label: "Next month";
                    enabled: root.next-enabled;
                    font-size: root.month-font;
                    stepped => { ReportData.month-stepped(root.name, 1); }
                }
            }

            HorizontalLayout {
                for weekday in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]: Text {
                    width: root.cell-size;
                    text: weekday;
                    font-size: root.weekday-font;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                    opacity: 0.55;
                }
            }

            // Six weeks, always, so the box keeps its height as the months are paged through.
            for week in 6: HorizontalLayout {
                for weekday in 7: DayCell {
                    day: root.days[week * 7 + weekday];
                    calendar-name: root.name;
                    cell-size: root.cell-size;
                    font-size: root.day-font;
                    corner: root.day-corner;
                }
            }
        }
    }
}

component EntryRow inherits Rectangle {
    in property <ReportEntry> entry;

    height: 24px;
    accessible-role: AccessibleRole.text;
    accessible-id: "report-entry-" + root.entry.id;
    accessible-label: root.entry.label;

    HorizontalLayout {
        padding-left: 64px;
        padding-right: 8px;
        spacing: 0px;

        Text { width: 52px; text: root.entry.date; font-size: Metrics.footnote-font-size; vertical-alignment: center; color: Palette.foreground; opacity: 0.7; }
        Text { width: 68px; text: root.entry.began; font-size: Metrics.footnote-font-size; vertical-alignment: center; color: Palette.foreground; opacity: 0.7; }
        Text { width: 16px; text: "\u{2013}"; font-size: Metrics.footnote-font-size; vertical-alignment: center; color: Palette.foreground; opacity: 0.7; }
        Text { width: 68px; text: root.entry.ended; font-size: Metrics.footnote-font-size; vertical-alignment: center; color: Palette.foreground; opacity: 0.7; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.entry.duration; font-size: Metrics.footnote-font-size; vertical-alignment: center; horizontal-alignment: right; color: Palette.foreground; opacity: 0.7; }
    }
}

component TotalGroup inherits VerticalLayout {
    in property <ReportTotal> total;

    accessible-role: groupbox;
    accessible-id: "report-total-" + root.total.id;
    accessible-label: root.total.name;

    // The heading line: the triangle, then the rest of the line, and all of it folds the group.
    Rectangle {
        height: 36px;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 0px;

            Rectangle {
                width: 16px;
                accessible-role: button;
                accessible-id: "report-total-" + root.total.id + "-toggle";
                accessible-label: root.total.name + " entries";
                accessible-action-default => { ReportData.total-toggled(root.total.id); }
                Path {
                    width: 9px;
                    height: 9px;
                    viewbox-width: 9;
                    viewbox-height: 9;
                    commands: root.total.is-expanded
                        ? "M 0.5 2.5 L 8.5 2.5 L 4.5 7.5 Z"
                        : "M 2.5 0.5 L 7.5 4.5 L 2.5 8.5 Z";
                    fill: Palette.foreground;
                    opacity: 0.75;
                }
                TouchArea { clicked => { ReportData.total-toggled(root.total.id); } }
            }

            Rectangle {
                accessible-role: button;
                accessible-id: "report-total-" + root.total.id + "-heading";
                accessible-label: root.total.name + ", " + root.total.duration;
                accessible-action-default => { ReportData.total-toggled(root.total.id); }

                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 12px;
                    Rectangle {
                        width: 28px;
                        Swatch {
                            colour: root.total.colour;
                            has-colour: root.total.has-colour;
                            icon: root.total.icon;
                            has-icon: root.total.has-icon;
                            white-lines: root.total.white-lines;
                            size: 28px;
                            radius: 6px;
                        }
                    }
                    Text {
                        text: root.total.name;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground;
                    }
                    Text {
                        text: root.total.duration;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 0;
                        color: Palette.foreground;
                        accessible-role: AccessibleRole.text;
                        accessible-id: "report-total-" + root.total.id + "-duration";
                        accessible-label: root.total.duration;
                    }
                }
                TouchArea { clicked => { ReportData.total-toggled(root.total.id); } }
            }
        }
    }

    if root.total.is-expanded: VerticalLayout {
        for entry in root.total.entries: EntryRow { entry: entry; }
        if root.total.entries.length == 0: Text {
            height: 24px;
            text: "No entries left in this range.";
            font-size: Metrics.footnote-font-size;
            vertical-alignment: center;
            color: Palette.foreground;
            opacity: 0.55;
        }
    }
}

export component ReportPane inherits Rectangle {
    accessible-role: tab-panel;
    accessible-id: "settings-pane-report";
    accessible-label: "Report";

    // Seven columns out of what is left after the tab's padding, the gap between the pair and each calendar's
    // own padding, rounded down so the pair never overflows, and never below 28.
    property <length> cell-size: max(
        28px,
        Math.floor((((root.width - 2 * Metrics.tab-padding - 12px) / 2 - 16px) / 7) / 1px) * 1px
    );

    VerticalLayout {
        padding: Metrics.tab-padding;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            accessible-role: groupbox;
            accessible-id: "report-range";
            accessible-label: "Range";

            RangeCalendar {
                title: "From";
                name: "from";
                month-title: ReportData.from-month;
                days: ReportData.from-days;
                previous-enabled: ReportData.from-previous-enabled;
                next-enabled: ReportData.from-next-enabled;
                cell-size: root.cell-size;
            }
            RangeCalendar {
                title: "To";
                name: "to";
                subtitle: ReportData.to-subtitle;
                month-title: ReportData.to-month;
                days: ReportData.to-days;
                previous-enabled: ReportData.to-previous-enabled;
                next-enabled: ReportData.to-next-enabled;
                cell-size: root.cell-size;
            }
        }

        Divider { }

        VerticalLayout {
            vertical-stretch: 1;
            accessible-role: groupbox;
            accessible-id: "report-totals";
            accessible-label: "Totals";

            HorizontalLayout {
                height: 24px;
                padding-left: 64px;
                padding-right: 8px;

                Rectangle {
                    accessible-role: button;
                    accessible-id: "report-sort-category";
                    accessible-label: ReportData.category-heading;
                    accessible-action-default => { ReportData.sort-pressed("category"); }
                    horizontal-stretch: 0;
                    width: category-text.preferred-width;
                    category-text := Text {
                        text: ReportData.category-heading;
                        font-size: Metrics.footnote-font-size;
                        font-weight: 600;
                        vertical-alignment: center;
                        color: Palette.foreground;
                        opacity: 0.55;
                    }
                    TouchArea { clicked => { ReportData.sort-pressed("category"); } }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    accessible-role: button;
                    accessible-id: "report-sort-time";
                    accessible-label: ReportData.time-heading;
                    accessible-action-default => { ReportData.sort-pressed("time"); }
                    horizontal-stretch: 0;
                    width: time-text.preferred-width;
                    time-text := Text {
                        text: ReportData.time-heading;
                        font-size: Metrics.footnote-font-size;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        color: Palette.foreground;
                        opacity: 0.55;
                    }
                    TouchArea { clicked => { ReportData.sort-pressed("time"); } }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;

                VerticalLayout {
                    alignment: start;
                    for total[index] in ReportData.totals: VerticalLayout {
                        if index > 0: Rectangle { height: 1px; background: Palette.border; }
                        TotalGroup { total: total; }
                    }
                    if ReportData.totals.length == 0: Text {
                        text: "No time recorded in this range.";
                        color: Palette.foreground;
                        opacity: 0.55;
                        accessible-role: AccessibleRole.text;
                        accessible-id: "report-totals-empty";
                        accessible-label: "No time recorded in this range.";
                    }
                }
            }
        }
    }
}
