// The Device tab: what the app knows about a cube, the way to go and find one, and the settings that live on
// one.
//
// **Two sections, as the Swift app has them.**
//
// - **TimeFlip** is the cube itself: what the app knows about it, and what to press to get one. Its rows say
//   plainly when the answer is that it knows nothing, and under them sit the controls that change with the
//   state, Scan while there is nothing paired and Forget and Reset once there is.
// - **Settings** are what the cube is set to: stored here and sent to it while connected, so they are readable
//   with no cube present, which is why they are drawn rather than hidden.
//
// **The whole Settings section is dead while no cube is connected**, every row of it, including the two that
// no command carries. It is a section about a cube, so it answers the question about a cube the same way in
// every row.
//
// Everything shown comes from `DeviceData`, which the Device controller in `src/device.rs` fills from the table
// and the radio.

import { CheckBox, Button, ScrollView } from "std-widgets.slint";
import { Metrics } from "metrics.slint";
import { Panel, SectionHeading, SettingsRow, StepperField, ValueText, Footnote } from "widgets.slint";

// One device a scan heard.
export struct FoundDevice {
    handle: string,
    label: string,
}

export global DeviceData {
    in-out property <bool> timeflip-expanded: true;
    in-out property <bool> settings-expanded: true;
    in-out property <bool> more-expanded: false;
    in-out property <bool> led-expanded: false;

    in property <bool> paired: false;
    in property <string> device-name: "Not paired";
    in property <string> connection: "Manual mode, no device";
    in property <string> battery: "Not paired";
    in property <string> manufacturer: "Not paired";
    in property <string> model: "Not paired";
    in property <string> hardware: "Not paired";
    in property <string> firmware: "Not paired";

    // Says what the radio is doing, and it is not decoration: an empty list means "nothing found",
    // "Bluetooth is off" and "not allowed to use Bluetooth" all at once, and those want three different
    // things done about them.
    in property <string> scan-status: "";
    in property <bool> is-scanning: false;
    in-out property <bool> scan-all: false;
    in property <[FoundDevice]> found: [];
    // While a pairing is under way the results are not offered: one attempt at a time.
    in property <bool> is-reaching-for-cube: false;
    in property <bool> can-scan: true;

    in-out property <bool> pause-on-lock: true;
    in-out property <int> battery-warning-percent: 10;
    in-out property <int> auto-pause-minutes: 0;
    in-out property <int> led-brightness-percent: 50;
    in-out property <int> led-blink-seconds: 15;

    // Every row of the Settings section is dead together, decided in one place for all of them.
    in property <bool> cube-connected: false;

    callback section-toggled(string, bool);
    callback scan-pressed();
    callback found-pressed(string);
    callback forget-pressed();
    callback reset-pressed();
    callback pause-on-lock-toggled(bool);
    callback battery-warning-edited(int);
    callback auto-pause-edited(int);
    callback led-brightness-edited(int);
    callback led-blink-edited(int);
}

component FoundRow inherits Button {
    in property <FoundDevice> device;
    text: root.device.label;
    accessible-id: "device-scan-result-" + root.device.handle;
}

export component DevicePane inherits Rectangle {
    accessible-role: tab-panel;
    accessible-id: "settings-pane-device";
    accessible-label: "Device";

    ScrollView {
        // **The content is as wide as the view, not as wide as it would like to be.** Left to itself a scroll
        // view sizes its viewport to the content's preferred width, and a wrapped footnote prefers the width of
        // its whole sentence on one line. It then measured one line tall, wrapped to two at the real width, and
        // the second line sat outside the panel it belongs to.
        content-width: self.visible-width;

        VerticalLayout {
            padding: Metrics.tab-padding;
            spacing: Metrics.section-spacing;
            alignment: start;

            Panel {
                panel-id: "device-timeflip-section-panel";
                label: "TimeFlip";

                SectionHeading {
                    title: "TimeFlip";
                    heading-id: "device-timeflip-section-heading";
                    expanded <=> DeviceData.timeflip-expanded;
                    toggled(open) => { DeviceData.section-toggled("device-timeflip-section", open); }
                }

                if DeviceData.timeflip-expanded: VerticalLayout {
                    spacing: Metrics.row-spacing;

                    SettingsRow {
                        label: "Name";
                        dimmed: !DeviceData.cube-connected;
                        ValueText { text: DeviceData.device-name; value-id: "device-name"; }
                    }
                    SettingsRow {
                        label: "Connection";
                        ValueText { text: DeviceData.connection; value-id: "device-connection"; }
                    }
                    SettingsRow {
                        label: "Battery";
                        dimmed: !DeviceData.cube-connected;
                        ValueText { text: DeviceData.battery; value-id: "device-battery"; }
                    }

                    // **Folded, because four strings a cube reports about itself are the tab's least urgent
                    // fact.** A row of the list rather than a panel of its own: the panel is already there, so
                    // there is nothing of this group's own to close.
                    SectionHeading {
                        title: "More";
                        heading-id: "device-more";
                        nested: true;
                        expanded <=> DeviceData.more-expanded;
                        toggled(open) => { DeviceData.section-toggled("device-more", open); }
                    }
                    if DeviceData.more-expanded: VerticalLayout {
                        padding-left: Metrics.nested-indent;
                        spacing: Metrics.row-spacing;

                        SettingsRow {
                            label: "Manufacturer";
                            dimmed: !DeviceData.cube-connected;
                            ValueText { text: DeviceData.manufacturer; value-id: "device-manufacturer"; }
                        }
                        SettingsRow {
                            label: "Model";
                            dimmed: !DeviceData.cube-connected;
                            ValueText { text: DeviceData.model; value-id: "device-model"; }
                        }
                        SettingsRow {
                            label: "Hardware";
                            dimmed: !DeviceData.cube-connected;
                            ValueText { text: DeviceData.hardware; value-id: "device-hardware"; }
                        }
                        SettingsRow {
                            label: "Firmware";
                            dimmed: !DeviceData.cube-connected;
                            ValueText { text: DeviceData.firmware; value-id: "device-firmware"; }
                        }
                    }

                    // **What the section offers changes with whether there is a cube.** Scan and All Devices
                    // while there is nothing paired, Forget and Reset once there is: a scan sitting beside a
                    // cube that is already paired is offering to solve a problem nobody has.
                    //
                    // The status sits on the button's own row at the trailing edge, because it is the answer
                    // to the question the button asks, and because a row of its own made the panel taller by
                    // an empty line whenever there was nothing to say.
                    HorizontalLayout {
                        spacing: Metrics.column-spacing;
                        padding-top: 11px;
                        padding-bottom: 11px;

                        if !DeviceData.paired: Button {
                            text: DeviceData.is-scanning ? "Stop Scan" : "Scan for Devices";
                            enabled: DeviceData.can-scan && !DeviceData.is-reaching-for-cube;
                            accessible-id: "device-scan";
                            clicked => { DeviceData.scan-pressed(); }
                        }
                        // **A filtered scan is the default and this is the way out of it.** The filter matches
                        // the vendor name and the names this cube has carried, which is also what hides a cube
                        // whose name the app has never seen.
                        if !DeviceData.paired: CheckBox {
                            text: "All Devices";
                            checked <=> DeviceData.scan-all;
                            accessible-id: "device-scan-all";
                        }
                        if DeviceData.paired: Button {
                            text: "Forget Device";
                            enabled: !DeviceData.is-reaching-for-cube;
                            accessible-id: "device-forget";
                            clicked => { DeviceData.forget-pressed(); }
                        }
                        if DeviceData.paired: Button {
                            text: "Reset Device";
                            enabled: DeviceData.cube-connected && !DeviceData.is-reaching-for-cube;
                            accessible-id: "device-reset";
                            clicked => { DeviceData.reset-pressed(); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // The words give way before the controls do: a window too narrow for both shortens the
                        // message, not the button that starts the scan.
                        ValueText { text: DeviceData.scan-status; value-id: "device-scan-status"; }
                    }

                    // The found devices, one row each, the whole row being the button. Absent rather than empty
                    // until a scan has found something, so it leaves no gap.
                    if !DeviceData.paired && DeviceData.found.length > 0: VerticalLayout {
                        spacing: Metrics.row-spacing;
                        for device in DeviceData.found: FoundRow {
                            device: device;
                            enabled: !DeviceData.is-reaching-for-cube;
                            clicked => { DeviceData.found-pressed(device.handle); }
                        }
                    }
                }
            }

            Panel {
                panel-id: "device-settings-section-panel";
                label: "Device settings";

                SectionHeading {
                    title: "Settings";
                    heading-id: "device-settings-section-heading";
                    expanded <=> DeviceData.settings-expanded;
                    toggled(open) => { DeviceData.section-toggled("device-settings-section", open); }
                }

                if DeviceData.settings-expanded: VerticalLayout {
                    spacing: Metrics.row-spacing;

                    // Says what the app does to the cube when it locks it: the lock drives the pause, not the
                    // other way round. No command carries it, so the whole of writing it is the table taking
                    // it, and it is here rather than on the App tab because it is about the cube.
                    SettingsRow {
                        label: "Pause the device when locking it";
                        dimmed: !DeviceData.cube-connected;
                        CheckBox {
                            checked <=> DeviceData.pause-on-lock;
                            enabled: DeviceData.cube-connected;
                            accessible-id: "device-pause-on-lock";
                            toggled => { DeviceData.pause-on-lock-toggled(self.checked); }
                        }
                    }

                    SettingsRow {
                        label: "Battery warning at";
                        dimmed: !DeviceData.cube-connected;
                        StepperField {
                            value <=> DeviceData.battery-warning-percent;
                            minimum: 1;
                            maximum: 20;
                            suffix: "%";
                            enabled: DeviceData.cube-connected;
                            field-id: "device-battery-warning";
                            edited(value) => { DeviceData.battery-warning-edited(value); }
                        }
                    }

                    // **The label states the ceiling and takes it from the same place the field does**, so it
                    // cannot come to promise a limit the wire does not keep. 0 disables it, which is the
                    // vendor protocol's own disabled-by-default behaviour.
                    SettingsRow {
                        label: "Auto-pause (0 disable, max 240m)";
                        dimmed: !DeviceData.cube-connected;
                        StepperField {
                            value <=> DeviceData.auto-pause-minutes;
                            minimum: 0;
                            maximum: 240;
                            suffix: "min";
                            enabled: DeviceData.cube-connected;
                            field-id: "device-auto-pause";
                            edited(value) => { DeviceData.auto-pause-edited(value); }
                        }
                    }

                    SectionHeading {
                        title: "LED";
                        heading-id: "device-led";
                        nested: true;
                        expanded <=> DeviceData.led-expanded;
                        toggled(open) => { DeviceData.section-toggled("device-led", open); }
                    }
                    if DeviceData.led-expanded: VerticalLayout {
                        padding-left: Metrics.nested-indent;
                        spacing: Metrics.row-spacing;

                        // **Arrows rather than a slider**, which is the Swift app's finding and worth keeping
                        // the reason for: a slider commits a value per pixel of travel, and one brightness
                        // drag logged thirty-odd changes, every one of them a device write.
                        SettingsRow {
                            label: "Brightness";
                            dimmed: !DeviceData.cube-connected;
                            StepperField {
                                value <=> DeviceData.led-brightness-percent;
                                minimum: 1;
                                maximum: 100;
                                suffix: "%";
                                enabled: DeviceData.cube-connected;
                                field-id: "device-led-brightness";
                                edited(value) => { DeviceData.led-brightness-edited(value); }
                            }
                        }
                        SettingsRow {
                            label: "Blink Interval";
                            dimmed: !DeviceData.cube-connected;
                            StepperField {
                                value <=> DeviceData.led-blink-seconds;
                                minimum: 5;
                                maximum: 60;
                                suffix: "sec";
                                enabled: DeviceData.cube-connected;
                                field-id: "device-led-blink";
                                edited(value) => { DeviceData.led-blink-edited(value); }
                            }
                        }
                    }

                    // **Not the Swift app's, and it is the one piece of wording here that is an addition.** Its
                    // Settings section goes dead with no cube and says nothing about why. Every row being
                    // greyed with no reason given reads as a fault rather than as a state, so this says which.
                    // Inside the panel rather than under it: it has no reason to outlive its section.
                    if !DeviceData.cube-connected: Footnote {
                        note-id: "device-settings-gate-note";
                        text: "These are what the cube is set to, and they are sent to it while it is connected. "
                            + "There is no cube connected, so there is nothing to send them to yet.";
                    }
                }
            }
        }
    }
}
