// The App tab: how the app itself behaves, as opposed to what it is timing.
//
// Three sections in the Swift app's order and wording: App settings, then Google, then Debug. The first two
// start open and Debug folded, every time the window opens. The Google footnote sits outside its panel and
// folds with it. Everything shown comes from `AppData`, which Rust fills; every change is a callback on it.

import { CheckBox, Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Metrics } from "metrics.slint";
import { Panel, SectionHeading, SettingsRow, StepperField, ValueText, Footnote } from "widgets.slint";

export global AppData {
    in-out property <bool> app-expanded: true;
    in-out property <bool> google-expanded: true;
    in-out property <bool> debug-expanded: false;

    // App settings.
    in-out property <bool> shows-seconds: true;
    in-out property <int> reset-hour: 3;
    in-out property <int> fetch-minutes: 1;
    in-out property <int> blip-seconds: 5;

    // Google.
    in property <string> google-status: "Not connected";
    in property <string> google-name;
    in property <string> google-email;
    in property <string> google-button-label: "Google";
    in property <string> google-button-text: "Sign in with Google";
    in property <bool> google-button-enabled: false;
    // The calendar row: shown only while an account is connected.
    in property <bool> shows-calendar-row: false;
    in property <bool> has-calendar: false;
    in property <string> calendar-name;
    in property <bool> calendar-enabled: true;
    in-out property <bool> calendar-editing: false;
    in-out property <string> calendar-typed;
    in property <string> google-note;

    // Debug.
    in-out property <bool> debug-enabled: false;
    in property <string> debug-directory;
    in property <bool> has-debug-trace: false;

    callback section-toggled(string, bool);
    callback shows-seconds-toggled(bool);
    callback reset-hour-edited(int);
    callback fetch-minutes-edited(int);
    callback blip-seconds-edited(int);
    callback google-button-pressed();
    callback calendar-create-pressed();
    callback calendar-delete-pressed();
    callback calendar-rename-opened();
    callback calendar-rename-committed(string);
    callback debug-toggled(bool);
    callback debug-choose-pressed();
    callback debug-reveal-pressed();
    callback debug-copy-pressed();
    callback debug-clear-pressed();
}

export component AppPane inherits Rectangle {
    accessible-role: tab-panel;
    accessible-id: "settings-pane-app";
    accessible-label: "App";

    ScrollView {
        content-width: self.visible-width;

        VerticalLayout {
            padding: Metrics.tab-padding;
            spacing: Metrics.section-spacing;
            alignment: start;

            Panel {
                panel-id: "app-settings-section-panel";
                label: "App settings";

                SectionHeading {
                    title: "App settings";
                    heading-id: "app-settings-section-heading";
                    expanded <=> AppData.app-expanded;
                    toggled(open) => { AppData.section-toggled("app-settings-section", open); }
                }

                if AppData.app-expanded: VerticalLayout {
                    spacing: Metrics.row-spacing;

                    SettingsRow {
                        label: "Show seconds";
                        CheckBox {
                            checked <=> AppData.shows-seconds;
                            accessible-id: "app-show-seconds";
                            accessible-label: "Show seconds";
                            toggled => { AppData.shows-seconds-toggled(self.checked); }
                        }
                    }

                    SettingsRow {
                        label: "Daily reset at";
                        StepperField {
                            value <=> AppData.reset-hour;
                            minimum: 1;
                            maximum: 12;
                            suffix: "AM";
                            field-id: "app-daily-reset";
                            edited(value) => { AppData.reset-hour-edited(value); }
                        }
                    }

                    SettingsRow {
                        label: "Fetch history every";
                        StepperField {
                            value <=> AppData.fetch-minutes;
                            minimum: 1;
                            maximum: 60;
                            suffix: AppData.fetch-minutes == 1 ? "min" : "mins";
                            field-id: "app-fetch-interval";
                            edited(value) => { AppData.fetch-minutes-edited(value); }
                        }
                    }

                    SettingsRow {
                        label: "Ignore flips under";
                        StepperField {
                            value <=> AppData.blip-seconds;
                            minimum: 0;
                            maximum: 30;
                            suffix: AppData.blip-seconds == 1 ? "sec" : "secs";
                            field-id: "app-blip-time";
                            edited(value) => { AppData.blip-seconds-edited(value); }
                        }
                    }
                }
            }

            Panel {
                panel-id: "app-google-section-panel";
                label: "Google";

                SectionHeading {
                    title: "Google";
                    heading-id: "app-google-section-heading";
                    expanded <=> AppData.google-expanded;
                    toggled(open) => { AppData.section-toggled("app-google-section", open); }
                }

                if AppData.google-expanded: VerticalLayout {
                    spacing: Metrics.row-spacing;

                    SettingsRow {
                        label: "Status";
                        ValueText { text: AppData.google-status; value-id: "app-google-status"; }
                    }

                    if AppData.google-name != "": SettingsRow {
                        label: "Account";
                        ValueText { text: AppData.google-name; value-id: "app-google-account"; }
                    }

                    if AppData.google-email != "": SettingsRow {
                        label: "Email";
                        ValueText { text: AppData.google-email; value-id: "app-google-email"; }
                    }

                    SettingsRow {
                        label: AppData.google-button-label;
                        Button {
                            text: AppData.google-button-text;
                            enabled: AppData.google-button-enabled;
                            accessible-id: "app-google-button";
                            clicked => { AppData.google-button-pressed(); }
                        }
                    }

                    if AppData.shows-calendar-row: SettingsRow {
                        label: "Calendar";

                        if !AppData.has-calendar: Button {
                            text: "Create calendar";
                            enabled: AppData.calendar-enabled;
                            accessible-id: "app-google-calendar-create";
                            clicked => { AppData.calendar-create-pressed(); }
                        }

                        if AppData.has-calendar && !AppData.calendar-editing: Rectangle {
                            width: 240px;
                            accessible-role: button;
                            accessible-id: "app-google-calendar";
                            accessible-label: AppData.calendar-name;
                            accessible-action-default => {
                                if AppData.calendar-enabled { AppData.calendar-rename-opened(); }
                            }
                            ValueText { width: 100%; text: AppData.calendar-name; value-id: "app-google-calendar-name"; }
                            TouchArea { clicked => { if AppData.calendar-enabled { AppData.calendar-rename-opened(); } } }
                        }

                        if AppData.has-calendar && AppData.calendar-editing: FocusScope {
                            width: 240px;
                            key-pressed(event) => {
                                if event.text == Key.Escape {
                                    AppData.calendar-editing = false;
                                    return accept;
                                }
                                reject
                            }
                            LineEdit {
                                text <=> AppData.calendar-typed;
                                horizontal-alignment: right;
                                accessible-id: "app-google-calendar-field";
                                accessible-label: "Calendar name";
                                accepted(text) => { AppData.calendar-rename-committed(text); }
                                init => { self.focus(); self.select-all(); }
                            }
                        }

                        if AppData.has-calendar: Button {
                            text: "Delete";
                            enabled: AppData.calendar-enabled;
                            accessible-id: "app-google-calendar-delete";
                            clicked => { AppData.calendar-delete-pressed(); }
                        }
                    }
                }
            }

            if AppData.google-expanded && AppData.google-note != "": Footnote {
                text: AppData.google-note;
                note-id: "app-google-note";
            }

            Panel {
                panel-id: "app-debug-section-panel";
                label: "Debug";

                SectionHeading {
                    title: "Debug";
                    heading-id: "app-debug-section-heading";
                    expanded <=> AppData.debug-expanded;
                    toggled(open) => { AppData.section-toggled("app-debug-section", open); }
                }

                if AppData.debug-expanded: VerticalLayout {
                    spacing: Metrics.row-spacing;

                    SettingsRow {
                        label: "Debug logging";
                        CheckBox {
                            checked <=> AppData.debug-enabled;
                            accessible-id: "app-debug-enabled";
                            accessible-label: "Debug logging";
                            toggled => { AppData.debug-toggled(self.checked); }
                        }
                    }

                    SettingsRow {
                        label: "Directory";
                        ValueText {
                            text: AppData.debug-directory;
                            value-id: "app-debug-directory";
                            max-width: 340px;
                        }
                        Button {
                            text: "Choose";
                            accessible-id: "app-debug-directory-choose";
                            clicked => { AppData.debug-choose-pressed(); }
                        }
                    }

                    SettingsRow {
                        label: "Trace file";
                        HorizontalLayout {
                            spacing: Metrics.heading-spacing;
                            Button {
                                text: "Reveal in Finder";
                                enabled: AppData.has-debug-trace;
                                accessible-id: "app-debug-reveal";
                                clicked => { AppData.debug-reveal-pressed(); }
                            }
                            Button {
                                text: "Save a copy";
                                enabled: AppData.has-debug-trace;
                                accessible-id: "app-debug-copy";
                                clicked => { AppData.debug-copy-pressed(); }
                            }
                            Button {
                                text: "Clear";
                                enabled: AppData.has-debug-trace;
                                accessible-id: "app-debug-clear";
                                clicked => { AppData.debug-clear-pressed(); }
                            }
                        }
                    }

                    Footnote {
                        note-id: "app-debug-note";
                        text: "Logging starts and stops as this is switched, and is kept in a file called "
                            + "debug.sqlite in this folder. A folder chosen here is used from the next time "
                            + "Facet starts.";
                    }
                }
            }
        }
    }
}
